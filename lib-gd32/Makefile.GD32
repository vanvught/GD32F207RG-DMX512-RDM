$(info "lib-gd32/Makefile.GD32")
$(info $$FAMILY [${FAMILY}])
$(info $$MAKE_FLAGS [${MAKE_FLAGS}])

DEFINES=NDEBUG

EXTRA_SRCDIR =src/f

EXTRA_C_SOURCE_FILES =

ifneq ($(MAKE_FLAGS),)
	EXTRA_SRCDIR+=gd32f20x/CMSIS/GD/GD32F20x/Source
  	
  	EXTRA_C_SOURCE_FILES+=gd32f20x/GD32F20x_standard_peripheral/Source/gd32f20x_adc.c
  	EXTRA_C_SOURCE_FILES+=gd32f20x/GD32F20x_standard_peripheral/Source/gd32f20x_bkp.c
  	EXTRA_C_SOURCE_FILES+=gd32f20x/GD32F20x_standard_peripheral/Source/gd32f20x_dma.c
  	EXTRA_C_SOURCE_FILES+=gd32f20x/GD32F20x_standard_peripheral/Source/gd32f20x_enet.c
  	EXTRA_C_SOURCE_FILES+=gd32f20x/GD32F20x_standard_peripheral/Source/gd32f20x_exti.c
  	EXTRA_C_SOURCE_FILES+=gd32f20x/GD32F20x_standard_peripheral/Source/gd32f20x_fmc.c
  	EXTRA_C_SOURCE_FILES+=gd32f20x/GD32F20x_standard_peripheral/Source/gd32f20x_fwdgt.c
  	EXTRA_C_SOURCE_FILES+=gd32f20x/GD32F20x_standard_peripheral/Source/gd32f20x_gpio.c
  	EXTRA_C_SOURCE_FILES+=gd32f20x/GD32F20x_standard_peripheral/Source/gd32f20x_i2c.c
  	EXTRA_C_SOURCE_FILES+=gd32f20x/GD32F20x_standard_peripheral/Source/gd32f20x_pmu.c
  	EXTRA_C_SOURCE_FILES+=gd32f20x/GD32F20x_standard_peripheral/Source/gd32f20x_rcu.c
  	EXTRA_C_SOURCE_FILES+=gd32f20x/GD32F20x_standard_peripheral/Source/gd32f20x_rtc.c
  	EXTRA_C_SOURCE_FILES+=gd32f20x/GD32F20x_standard_peripheral/Source/gd32f20x_spi.c
  	EXTRA_C_SOURCE_FILES+=gd32f20x/GD32F20x_standard_peripheral/Source/gd32f20x_usart.c
  	EXTRA_C_SOURCE_FILES+=gd32f20x/GD32F20x_standard_peripheral/Source/gd32f20x_timer.c
  	
	ifeq ($(findstring NO_EMAC,$(MAKE_FLAGS)), NO_EMAC)
	else
		EXTRA_SRCDIR+=device/enet/f
  	endif
  	
	ifeq ($(findstring ENABLE_USB_HOST,$(MAKE_FLAGS)), ENABLE_USB_HOST)		
		EXTRA_SRCDIR+=device/usb/f device/usb/f/host
		EXTRA_SRCDIR+=gd32f20x/GD32F20x_usbfs_library/host/core/Source
	  	EXTRA_C_SOURCE_FILES+=gd32f20x/GD32F20x_usbfs_library/driver/Source/drv_usb_core.c
	  	EXTRA_C_SOURCE_FILES+=gd32f20x/GD32F20x_usbfs_library/driver/Source/drv_usb_host.c
	  	EXTRA_C_SOURCE_FILES+=gd32f20x/GD32F20x_usbfs_library/driver/Source/drv_usbh_int.c
	  		
	  	ifeq ($(findstring CONFIG_USB_HOST_MSC,$(MAKE_FLAGS)), CONFIG_USB_HOST_MSC)
			EXTRA_C_SOURCE_FILES+=gd32f20x/GD32F20x_usbfs_library/host/class/msc/Source/usbh_msc_bbb.c
	  		EXTRA_C_SOURCE_FILES+=gd32f20x/GD32F20x_usbfs_library/host/class/msc/Source/usbh_msc_core.c
	  		EXTRA_C_SOURCE_FILES+=gd32f20x/GD32F20x_usbfs_library/host/class/msc/Source/usbh_msc_scsi.c
	  		EXTRA_SRCDIR+=device/usb/host/msc
	  	endif
	endif
else
	EXTRA_SRCDIR+=device/usb
	EXTRA_SRCDIR+=device/usb/f
	DEFINES+=CONFIG_ENABLE_I2C1
	DEFINES+=ENABLE_USB_HOST CONFIG_USB_HOST_MSC
endif

include Rules.mk
include ../firmware-template-gd32/lib/Rules.mk